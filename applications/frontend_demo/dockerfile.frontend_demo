FROM node:22.14.0-alpine

WORKDIR /app

# Copy the package files and install natively inside Alpine
COPY package*.json ./
RUN npm install

# Copy the rest of the application code
COPY . .

# Pre-create the volume targets so they exist in the image
RUN mkdir -p /app/.next /app/node_modules

# Grant the built-in 'node' user full ownership of the working directory
RUN chown -R node:node /app

# Switch away from root to the 'node' user BEFORE running the app
USER node

EXPOSE ${FRONTEND_DEMO_PORT_DOCKER}

CMD ["npm", "run", "dev"]